---
// Camera field-of-view coverage diagram with DORI distance bands.
// The hero motif — the most characteristic artifact in OSI's world.
---
<div class="diagram">
  <svg viewBox="0 0 620 430" width="100%" role="img" aria-label="Camera field-of-view coverage diagram with DORI distance bands: identify, recognize, detect">
    <rect x="0" y="0" width="620" height="430" fill="var(--surface)"></rect>
    <g stroke="var(--border-2)" stroke-width="1">
      <line x1="70" y1="0" x2="70" y2="430"></line>
      <line x1="230" y1="0" x2="230" y2="430"></line>
      <line x1="390" y1="0" x2="390" y2="430"></line>
      <line x1="540" y1="0" x2="540" y2="430"></line>
      <line x1="0" y1="210" x2="620" y2="210"></line>
    </g>
    <path d="M70,210 L533.5,22.5 A500,500 0 0,1 533.5,397.5 Z" fill="var(--brand)" fill-opacity="0.10"></path>
    <path d="M70,210 L375.9,86.25 A330,330 0 0,1 375.9,333.75 Z" fill="var(--brand)" fill-opacity="0.16"></path>
    <path d="M70,210 L227.6,146.25 A170,170 0 0,1 227.6,273.75 Z" fill="var(--brand)" fill-opacity="0.30"></path>
    <line x1="70" y1="210" x2="533.5" y2="22.5" stroke="var(--brand)" stroke-width="1.5"></line>
    <line x1="70" y1="210" x2="533.5" y2="397.5" stroke="var(--brand)" stroke-width="1.5"></line>
    <rect x="48" y="198" width="30" height="24" fill="var(--text)"></rect>
    <circle cx="78" cy="210" r="6" fill="var(--accent)"></circle>
    <g font-family="var(--font-mono)" font-size="12" fill="var(--text)">
      <text x="150" y="205" text-anchor="middle">IDENTIFY</text>
      <text x="300" y="205" text-anchor="middle">RECOGNIZE</text>
      <text x="455" y="205" text-anchor="middle">DETECT</text>
    </g>
    <g font-family="var(--font-mono)" font-size="10" fill="var(--text-muted)">
      <text x="150" y="222" text-anchor="middle">250 px/m</text>
      <text x="300" y="222" text-anchor="middle">125 px/m</text>
      <text x="455" y="222" text-anchor="middle">25 px/m</text>
    </g>
    <g stroke="var(--accent)" stroke-width="1.4">
      <line x1="70" y1="410" x2="533.5" y2="410"></line>
      <line x1="70" y1="404" x2="70" y2="416"></line>
      <line x1="533.5" y1="404" x2="533.5" y2="416"></line>
    </g>
    <text x="300" y="400" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text)">EFFECTIVE RANGE — DORI PER IEC 62676-4</text>
  </svg>
  <div class="cap"><span>FIG. 01 — FOV COVERAGE / DORI BANDS</span><span>SCALE NTS</span></div>
</div>
