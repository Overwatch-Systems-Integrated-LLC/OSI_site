---
// Camera field-of-view coverage diagram with DORI distance bands.
// The hero motif. Borderless — it sits on the hero's faint technical grid.
---
<svg viewBox="0 0 620 430" role="img" aria-label="Camera field-of-view coverage diagram with DORI distance bands: identify, recognize, detect">
  <!-- DORI sectors: detect (far/light) to identify (near/dark) -->
  <path d="M70,210 L533.5,22.5 A500,500 0 0,1 533.5,397.5 Z" fill="var(--brand)" fill-opacity="0.10"></path>
  <path d="M70,210 L375.9,86.25 A330,330 0 0,1 375.9,333.75 Z" fill="var(--brand)" fill-opacity="0.16"></path>
  <path d="M70,210 L227.6,146.25 A170,170 0 0,1 227.6,273.75 Z" fill="var(--brand)" fill-opacity="0.32"></path>
  <line x1="70" y1="210" x2="533.5" y2="22.5" stroke="var(--brand)" stroke-width="1.5"></line>
  <line x1="70" y1="210" x2="533.5" y2="397.5" stroke="var(--brand)" stroke-width="1.5"></line>
  <!-- camera -->
  <rect x="46" y="197" width="30" height="26" fill="var(--text)"></rect>
  <circle cx="76" cy="210" r="6.5" fill="var(--accent)"></circle>
  <!-- band labels -->
  <g font-family="var(--font-mono)" font-size="13" fill="var(--text)">
    <text x="150" y="205" text-anchor="middle">IDENTIFY</text>
    <text x="300" y="205" text-anchor="middle">RECOGNIZE</text>
    <text x="460" y="205" text-anchor="middle">DETECT</text>
  </g>
  <g font-family="var(--font-mono)" font-size="11" fill="var(--text-muted)">
    <text x="150" y="224" text-anchor="middle">250 px/m</text>
    <text x="300" y="224" text-anchor="middle">125 px/m</text>
    <text x="460" y="224" text-anchor="middle">25 px/m</text>
  </g>
  <!-- dimension line -->
  <g stroke="var(--accent)" stroke-width="1.4">
    <line x1="70" y1="410" x2="533.5" y2="410"></line>
    <line x1="70" y1="403" x2="70" y2="417"></line>
    <line x1="533.5" y1="403" x2="533.5" y2="417"></line>
  </g>
  <text x="300" y="401" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--text-muted)">EFFECTIVE RANGE — DORI PER IEC 62676-4</text>
</svg>
