---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CoverageWedge from '../components/CoverageWedge.astro';

const title = 'Overwatch Systems Integrated — Industrial Video Surveillance, Engineered';
const description = 'Overwatch Systems Integrated engineers and documents industrial video surveillance for Northeast Alabama facilities. Local presence. Industrial expertise.';

// Structured data (Phase C): restore the live homepage's LocalBusiness + WebSite
// nodes dropped in the Astro rebuild (preserve-and-extend, plan §6). LocalBusiness
// is the canonical #business entity; WebSite references it as publisher. Data is
// the verified live-site data (NAP city+state only, no street address).
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://www.overwatchsi.com/#business',
  name: 'Overwatch Systems Integrated',
  url: 'https://www.overwatchsi.com/',
  image: 'https://www.overwatchsi.com/images/og-image.png',
  logo: 'https://www.overwatchsi.com/images/Official_Logo.svg',
  telephone: '+1-256-240-0681',
  email: 'sales@overwatchsi.com',
  description: 'Industrial video surveillance systems and the network infrastructure that supports them, for industrial and commercial facilities in Northeast Alabama.',
  slogan: 'Local presence. Industrial expertise.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Oxford', addressRegion: 'AL', addressCountry: 'US',
  },
  areaServed: [
    'Calhoun County, AL', 'Etowah County, AL', 'DeKalb County, AL',
    'Cleburne County, AL', 'Jefferson County, AL', 'Northeast Alabama',
  ],
};
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Overwatch Systems Integrated',
  url: 'https://www.overwatchsi.com/',
  publisher: { '@id': 'https://www.overwatchsi.com/#business' },
};
---
<Base title={title} description={description}>
  <Nav />

  <!-- HERO -->
  <header class="container">
    <div class="hero">
      <div>
        <span class="eyebrow">Northeast Alabama · Industrial Video Surveillance</span>
        <h1>Recording is easy.<br />Evidence is <span class="mk">engineered.</span></h1>
        <p class="sub">We engineer camera coverage and the network that carries it, sized to the facility, documented to standard, and maintained after the install.</p>
        <p class="tag">Local presence. Industrial expertise.</p>
        <div class="cta">
          <a class="btn btn--primary" href="#contact">Request a Free Coverage Design →</a>
          <a class="btn btn--ghost" href="#tools">Open the tools</a>
        </div>
      </div>
      <figure class="hero__fig">
        <CoverageWedge />
        <figcaption class="cap"><span>FIG. 01 — FOV COVERAGE / DORI BANDS</span><span>SCALE NTS</span></figcaption>
      </figure>
    </div>
  </header>

  <!-- PROBLEM -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Who lives with the gap</span>
        <h2>Three Roles and the Failures at Their Feet</h2>
      </div>
      <div class="cols-3">
        <div class="pcol"><span class="k">Plant Manager</span><p class="q">"We had cameras. We still couldn't prove what happened."</p><p>Gaps in the layout stay invisible until the one recording you needed doesn't exist.</p></div>
        <div class="pcol"><span class="k">EHS / Safety</span><p class="q">"The one angle I needed was the one we didn't have."</p><p>Sightlines into hazardous zones get missed when coverage is placed, not engineered.</p></div>
        <div class="pcol"><span class="k">Security / IT Lead</span><p class="q">"The camera VLAN was the way in."</p><p>A flat network and a default login turn the camera system into a launch platform for malware.</p></div>
      </div>
    </div>
  </section>

  <!-- WHAT WE DO (panel band for rhythm) -->
  <section class="section band band--panel">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">What we do</span>
        <h2>Surveillance as Infrastructure</h2>
        <p class="lede">Not consumer-grade boxes thrown on a wall. Coverage is engineered from the backbone of your network to the lens of your camera, and documentation is always included and yours to keep. The system stays audit-ready as it scales.</p>
      </div>
      <div class="cols-3">
        <a class="svc" href="/pages/services.html#security-systems"><span class="k">SVC-01 / SECURITY CAMERAS</span><h3>Engineered camera coverage</h3><p>Field of view, overlap, and blind spots are designed before any hardware is ordered.</p><span class="more">See the work →</span></a>
        <a class="svc" href="/pages/services.html#network-infrastructure"><span class="k">SVC-02 / NETWORK</span><h3>Network infrastructure</h3><p>VLANs, switching, and capacity built to carry evidence-grade video without dropped frames.</p><span class="more">See the work →</span></a>
        <a class="svc" href="/pages/services.html#maintenance"><span class="k">SVC-03 / LIFECYCLE</span><h3>Lifecycle maintenance</h3><p>Ongoing service keeps your system safe and reliable for the day the footage actually matters.</p><span class="more">See the work →</span></a>
      </div>
    </div>
  </section>

  <!-- PROOF: the one dark control-room band -->
  <section class="section band band--dark" data-theme="dark">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Proof</span>
        <h2>The Differentiator Is Our Documentation</h2>
      </div>
      <div class="cols-2">
        <p class="proof-lead">An auditor, court, or incident responder won't take your word for it. They require a verified documentation packet. OSI provides your organization with one you can rely on.</p>
        <div>
          <p class="proof-body">Every camera, cable, port, and switch is labeled in the as-built. Retention and chain-of-custody are set up front, not requested after an incident. VLAN segmentation, firmware inventory, and the hardening baseline are recorded as part of the install. It is the documentation most vendors skip.</p>
          <a class="btn btn--primary" href="/proof/as-built-packet/" style="margin-top: var(--sp-5)">See what's in the packet →</a>
        </div>
      </div>
      <div class="stats">
        <div class="stat"><div class="n">3<small>×</small></div><div class="l">Documentation layers: as-built, evidence, and security baseline</div></div>
        <div class="stat"><div class="n">FRE&nbsp;901</div><div class="l">Retention and access records built for chain-of-custody</div></div>
        <div class="stat"><div class="n">BICSI</div><div class="l">As-built and network diagrams conformant to 005/007</div></div>
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="section" id="tools">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Tools</span>
        <h2>Two Free Tools That Remove the Guesswork</h2>
      </div>
      <div class="cols-2">
        <div class="tool2"><span class="k"><span>TOOL-01</span><span>INTERACTIVE</span></span><h3>Camera Coverage Sandbox</h3><p>Drop in a facility map, place Axis cameras, and see the field of view, overlap, and blind spots before anyone quotes hardware.</p><a class="btn btn--navy" href="/pages/camera-sandbox.html">Open sandbox →</a></div>
        <div class="tool2"><span class="k"><span>TOOL-02</span><span>CALCULATOR</span></span><h3>Pixels on Target</h3><p>Enter distance and lens, get pixels-per-foot against DORI thresholds, so identifying a face at 40 feet is calculated, not ballparked.</p><a class="btn btn--navy" href="/pages/pixels-on-target.html">Open calculator →</a></div>
      </div>
    </div>
  </section>

  <!-- CONTACT (panel band) -->
  <section class="section band band--panel" id="contact">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Start here</span>
        <h2>Request a Free Coverage Design</h2>
      </div>
      <div class="cols-2">
        <p class="lede">Tell us about your facility and what you're trying to protect. We'll come back with a free coverage design, no obligation. Prefer to talk? Call <a href="tel:+12562400681">(256) 240-0681</a> or email <a href="mailto:sales@overwatchsi.com">sales@overwatchsi.com</a>.</p>
        <form id="contact-form" novalidate>
          <div class="field-grid">
            <label>Full name<input name="fullname" type="text" required autocomplete="name" /></label>
            <label>Work email<input name="email" type="email" required autocomplete="email" /></label>
            <label>Phone<input name="phone" type="tel" autocomplete="tel" /></label>
            <label>What do you need?
              <select name="service">
                <option>Coverage design / assessment</option>
                <option>Camera system</option>
                <option>Network infrastructure</option>
                <option>Maintenance / service</option>
                <option>Something else</option>
              </select>
            </label>
            <label class="full">Message<textarea name="message" rows="4"></textarea></label>
          </div>
          <div class="form-row">
            <button class="btn btn--primary" type="submit">Send request →</button>
            <span id="contact-status" class="form-status" role="status"></span>
          </div>
        </form>
      </div>
    </div>
  </section>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} is:inline />

  <script is:inline>
    (function () {
      var form = document.getElementById('contact-form');
      var status = document.getElementById('contact-status');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!window.OSIHubSpot) { status.textContent = 'Form unavailable, please email sales@overwatchsi.com.'; return; }
        var fd = new FormData(form);
        var name = window.OSIHubSpot.splitName(fd.get('fullname'));
        var msg = '[' + (fd.get('service') || '') + '] ' + (fd.get('message') || '');
        status.textContent = 'Sending…';
        window.OSIHubSpot.submit('contact', {
          email: fd.get('email'), firstname: name.firstname, lastname: name.lastname,
          phone: fd.get('phone'), message: msg
        }).then(function () {
          form.reset(); status.textContent = 'Thanks! We will be in touch shortly.';
        }).catch(function () {
          status.textContent = 'Something went wrong. Please email sales@overwatchsi.com.';
        });
      });
    })();
  </script>
</Base>
