---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Unsubscribed — Overwatch Systems Integrated"
  description="You have been removed from the OSI field notes list."
  noindex={true}
>
  <Nav />

  <section class="section">
    <div class="container narrow">
      <span class="eyebrow">Field notes</span>
      <h1>You are unsubscribed.</h1>
      <p class="lede">
        We have removed you from the OSI field notes list. You will not receive any further posts.
      </p>
      <p>
        Changed your mind? <a href="/blog/#newsletter">Resubscribe from the blog</a>.
        Anything else, email <a href="mailto:sales@overwatchsi.com">sales@overwatchsi.com</a>.
      </p>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .narrow { max-width: 44rem; }
  h1 { font-size: clamp(2rem, 1.4rem + 2.5vw, 3rem); margin: var(--sp-3) 0 var(--sp-4); }
  p { color: var(--text-muted); margin-bottom: var(--sp-3); }
</style>
